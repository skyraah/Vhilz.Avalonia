<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Vhilz.Avalonia.Theme</RootNamespace>
        <AssemblyName>Vhilz.Avalonia</AssemblyName>
        <PackageId>Vhilz.Avalonia</PackageId>
        <Description>Avalonia 主题库，提供语义资源、自定义窗口与标题栏装饰。</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/skyraah/Vhilz.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <!-- Win32 LibraryImport 的生成代码需要 unsafe；权限限定在库项目。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Fluid.Avalonia.Acrylic"/>
        <PackageReference Include="Lucide.Avalonia"/>
        <PackageReference Include="SukiUI.Motion"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
