<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="using:SukiUI.Motion">
    <!-- 跨明暗不变且可供多个控件或应用稳定覆盖的几何资源在此定义；颜色语义在明暗字典中维护。 -->

    <!-- 窗口与操作按钮 -->

    <x:Double x:Key="Vhilz.Window.TitleBar.Height">32</x:Double>
    <Thickness x:Key="Vhilz.Window.FullscreenTitleBar.Margin">2</Thickness>
    <Thickness x:Key="Vhilz.Window.TitleBar.Title.Margin">12,0,12,0</Thickness>
    <x:Double x:Key="Vhilz.CaptionButton.Width">40</x:Double>
    <x:Double x:Key="Vhilz.CaptionButton.Icon.Size">16</x:Double>
    <x:Double x:Key="Vhilz.CaptionButton.Icon.StrokeWidth">2</x:Double>
    <!-- Restore在默认 16 DIP 下为 1 DIP；独立于其他 Lucide 图标 -->
    <x:Double x:Key="Vhilz.CaptionButton.Icon.Restore.StrokeWidth">1.5</x:Double>
    <CornerRadius x:Key="Vhilz.Radius.Small">5</CornerRadius>
    <Thickness x:Key="Vhilz.CaptionButton.Margin">1,2,1,2</Thickness>
    <Thickness x:Key="Vhilz.Window.FrameThickness">4</Thickness>
    <!-- 档位已获本轮授权；120/400ms 仍是按钮专属参数。圆角沿用现有值。 -->
    <x:TimeSpan x:Key="Vhilz.Duration.Fast">0:0:0.080</x:TimeSpan>
    <x:TimeSpan x:Key="Vhilz.Duration.Normal">0:0:0.160</x:TimeSpan>
    <x:TimeSpan x:Key="Vhilz.Duration.Slow">0:0:0.220</x:TimeSpan>
    <SineEaseInOut x:Key="Vhilz.Easing.Standard" />
    <CubicEaseOut x:Key="Vhilz.Easing.Decelerate" />
    <motion:SukiSpringEaseOut x:Key="Vhilz.Easing.Spring" />
    <x:Double x:Key="Vhilz.Opacity.Disabled">0.4</x:Double>
    <SolidColorBrush x:Key="Vhilz.Brush.OnDanger">White</SolidColorBrush>
    <!-- 焦点轮廓沿用 1 DIP 描边；正式观感仍由 Demo 验收。 -->
    <Thickness x:Key="Vhilz.Thickness.Focus">1</Thickness>
    <x:Double x:Key="Vhilz.CaptionButton.Icon.Maximize.Size">12</x:Double>
    <Thickness x:Key="Vhilz.CaptionButton.Group.Margin">2,1</Thickness>
    <!-- 默认中文只作回退；应用可在资源宿主覆盖这些键进行本地化。 -->
    <x:String x:Key="Vhilz.Text.Window.Fullscreen">全屏</x:String>
    <x:String x:Key="Vhilz.Text.Window.ExitFullscreen">退出全屏（Esc）</x:String>
    <x:String x:Key="Vhilz.Text.Window.Minimize">最小化</x:String>
    <x:String x:Key="Vhilz.Text.Window.Maximize">最大化</x:String>
    <x:String x:Key="Vhilz.Text.Window.Restore">还原</x:String>
    <x:String x:Key="Vhilz.Text.Window.Close">关闭</x:String>
</ResourceDictionary>
