<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.Separator.Thickness">1</x:Double>
    <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="{DynamicResource Vhilz.Separator.Thickness}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^.VhilzSeparatorVertical">
            <Setter Property="Width" Value="{DynamicResource Vhilz.Separator.Thickness}" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
