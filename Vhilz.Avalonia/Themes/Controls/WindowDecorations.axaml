<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vhz="https://github.com/skyraah/Vhilz.Avalonia"
                    xmlns:media="using:Avalonia.Media"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:transform="using:Avalonia.Media.Transformation"
                    xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
                    xmlns:acrylic="clr-namespace:Fluid.Avalonia.Acrylic;assembly=Fluid.Avalonia.Acrylic">

    <!-- 专属参数只表达标题栏按钮的差异；通用圆角、时长、缓动直接引用语义 Token。 -->
    <!-- 标题栏按钮的指针辉光描边；FAA 默认关闭，其余数值按按钮尺寸收紧。 -->
    <sys:Boolean x:Key="Vhilz.CaptionButton.RevealBorder.IsEnabled">True</sys:Boolean>
    <x:Double x:Key="Vhilz.CaptionButton.RevealBorder.Width">1</x:Double>
    <x:Double x:Key="Vhilz.CaptionButton.RevealBorder.Radius">55</x:Double>
    <x:Double x:Key="Vhilz.CaptionButton.RevealBorder.Intensity">0.75</x:Double>
    <x:Double x:Key="Vhilz.CaptionButton.RevealBorder.ProximityDistance">15</x:Double>

    <!-- 按压只缩放内部表面，保持窗口按钮的命中区域稳定。 -->
    <transform:TransformOperations x:Key="Vhilz.CaptionButton.Surface.Pressed.RenderTransform">scale(0.94)</transform:TransformOperations>
    <!-- 按钮染色采用无过冲缓动；与按压缩放的弹簧参数独立。 -->
    <sys:TimeSpan x:Key="Vhilz.CaptionButton.Duration.Color">0:0:0.12</sys:TimeSpan>
    <!-- 关闭按钮红色退场留出更长的缓出尾段。 -->
    <sys:TimeSpan x:Key="Vhilz.CaptionButton.Close.Duration.Reset">0:0:0.4</sys:TimeSpan>

    <!-- restore icon 16 DIP / 100% 下，像素对齐，特殊缩放需特殊处理 -->
    <StreamGeometry x:Key="Vhilz.CaptionButton.Icon.Restore.Geometry">
        M9.75 3.75h9.5a1 1 0 0 1 1 1v9.5
        M4.75 8.25h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-10a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1z
    </StreamGeometry>

    <!-- 装饰按钮只定义外观；点击、拖动、缩放逻辑移交Avalonia -->
    <!-- 图标共享尺寸与描边，特殊还原/最大化尺寸在实例上覆盖。 -->
    <ControlTheme x:Key="Vhilz.CaptionButton.Icon.Theme" TargetType="lucide:LucideIcon">
        <Setter Property="Size" Value="{DynamicResource Vhilz.CaptionButton.Icon.Size}" />
        <Setter Property="StrokeWidth" Value="{DynamicResource Vhilz.CaptionButton.Icon.StrokeWidth}" />
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.CaptionButton.Theme" TargetType="Button">

        <!-- 按钮组背景透明 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.TextSecondary}" />
        <!-- 非激活状态只影响常态；关闭按钮交互时仍保留白色图标。 -->
        <Style Selector="^[(vhz|DecorationRegistration.IsInactive)=True]:not(:pointerover):not(:pressed), ^[(vhz|DecorationRegistration.IsInactive)=True]:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.TextMuted}" />
        </Style>
        <!-- 按钮宽度跟随公共token -->
        <Setter Property="Width" Value="{DynamicResource Vhilz.CaptionButton.Width}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Margin" Value="{DynamicResource Vhilz.CaptionButton.Margin}" />

        <!-- 悬停时仅提升表面层次，保持图标前景色不变。 -->
        <Style Selector="^:pointerover:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.CaptionButton.PointerOver.BackgroundBrush}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.CaptionButton.Pressed.BackgroundBrush}" />
        </Style>
        <!-- 同一关闭语义供标题栏、全屏浮层和预览复用。 -->
        <Style Selector="^.VhilzCaptionClose:pointerover:not(:disabled)">
            <Setter Property="Background"
                    Value="{DynamicResource Vhilz.CaptionButton.Close.PointerOver.BackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Vhilz.Brush.OnDanger}" />
        </Style>
        <Style Selector="^.VhilzCaptionClose:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.CaptionButton.Close.Pressed.BackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Vhilz.Brush.OnDanger}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^ /template/ vhz|CaptionSurface#PART_CaptionSurface">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:pressed:not(:disabled) /template/ vhz|CaptionSurface#PART_CaptionSurface">
            <Setter Property="RenderTransform"
                    Value="{DynamicResource Vhilz.CaptionButton.Surface.Pressed.RenderTransform}" />
        </Style>

        <Style Selector="^.VhilzCaptionClose /template/ vhz|CaptionSurface#PART_CaptionSurface">
            <Setter Property="IsClose" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <!-- 保留完整点击区域，避免缩放时边缘失去命中而中断按压。 -->
                <Panel Background="Transparent">
                    <!-- FAA 1.4 的 TintColor 在 Alpha > 0 时完整替换色相；SurfaceColor 才能连续淡入。 -->
                    <vhz:CaptionSurface x:Name="PART_CaptionSurface"
                                        RenderTransformOrigin="50%,50%"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        HighlightEnabled="False"
                                        RevealBorderEnabled="{DynamicResource Vhilz.CaptionButton.RevealBorder.IsEnabled}"
                                        RevealBorderColor="{DynamicResource Vhilz.CaptionButton.RevealBorder.Color}"
                                        RevealBorderWidth="{DynamicResource Vhilz.CaptionButton.RevealBorder.Width}"
                                        RevealBorderRadius="{DynamicResource Vhilz.CaptionButton.RevealBorder.Radius}"
                                        RevealBorderIntensity="{DynamicResource Vhilz.CaptionButton.RevealBorder.Intensity}"
                                        RevealProximityDistance="{DynamicResource Vhilz.CaptionButton.RevealBorder.ProximityDistance}"
                                        TargetBackground="{TemplateBinding Background}"
                                        PressedBackground="{DynamicResource Vhilz.CaptionButton.Pressed.BackgroundBrush}"
                                        ClosePressedBackground="{DynamicResource Vhilz.CaptionButton.Close.Pressed.BackgroundBrush}"
                                        DefaultDuration="{DynamicResource Vhilz.CaptionButton.Duration.Color}"
                                        PressedDuration="{DynamicResource Vhilz.Duration.Fast}"
                                        CloseResetDuration="{DynamicResource Vhilz.CaptionButton.Close.Duration.Reset}"
                                        DefaultEasing="{DynamicResource Vhilz.Easing.Standard}"
                                        CloseResetEasing="{DynamicResource Vhilz.Easing.Decelerate}"
                                        TransformDuration="{DynamicResource Vhilz.Duration.Normal}"
                                        TransformEasing="{DynamicResource Vhilz.Easing.Spring}">
                        <!-- 画笔自身颜色变化仍需订阅；目标状态参数由表面的命名属性负责选择。 -->
                        <acrylic:AcrylicSurface.SurfaceColor>
                            <Binding Path="((media:ISolidColorBrush)Background).Color"
                                     RelativeSource="{RelativeSource TemplatedParent}"
                                     FallbackValue="Transparent" TargetNullValue="Transparent" />
                        </acrylic:AcrylicSurface.SurfaceColor>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </vhz:CaptionSurface>
                    <!-- 焦点轮廓独立于表面动画，键盘导航时不被按压缩放带走。 -->
                    <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                            Margin="{TemplateBinding Margin}" CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{DynamicResource Vhilz.Thickness.Focus}"
                            BorderBrush="{DynamicResource Vhilz.Brush.TextSecondary}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- 装饰位于独立视觉层，通过逻辑父窗口同步激活状态与主题资源。 -->
    <ControlTheme x:Key="Vhilz.Window.TitleBar.Title.Theme" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="{Binding $parent[vhz:VhilzWindow].TitleAlignment, FallbackValue=Left}" />
        <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="$parent[vhz:VhilzWindow].IsTitleVisible" FallbackValue="True" />
                <Binding Path="Text" RelativeSource="{RelativeSource Self}"
                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Window.TitleBar.ForegroundBrush}" />
        <Style Selector="^.VhilzInactive">
            <Setter Property="Foreground" Value="{DynamicResource Vhilz.Window.TitleBar.Inactive.ForegroundBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Vhilz.WindowDecorations.Theme" TargetType="WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="{DynamicResource Vhilz.Window.TitleBar.Height}" />
        <Setter Property="DefaultFrameThickness" Value="{DynamicResource Vhilz.Window.FrameThickness}" />
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>
                    <WindowDrawnDecorationsContent.Underlay>
                        <Panel>
                            <Border BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{Binding $parent[vhz:VhilzWindow].BorderBrush}"
                                    IsHitTestVisible="False" />

                            <Border Name="PartTitleBar"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    WindowDecorationProperties.ElementRole="TitleBar">
                                <Border Background="{Binding $parent[vhz:VhilzWindow].TitleBarBackground}">
                                    <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Title}"
                                               Theme="{StaticResource Vhilz.Window.TitleBar.Title.Theme}"
                                               Classes.VhilzInactive="{Binding !$parent[vhz:VhilzWindow].IsActive, FallbackValue=False}" />
                                </Border>
                            </Border>
                        </Panel>
                    </WindowDrawnDecorationsContent.Underlay>
                    <WindowDrawnDecorationsContent.Overlay>
                        <StackPanel Name="PART_CaptionButtons"
                                    vhz:DecorationRegistration.IsInactive="{Binding !$parent[vhz:VhilzWindow].IsActive, FallbackValue=False}"
                                    vhz:DecorationRegistration.Owner="{Binding $parent[vhz:VhilzWindow]}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    Orientation="Horizontal"
                                    Margin="{DynamicResource Vhilz.CaptionButton.Group.Margin}">

                            <!-- 全屏 -->
                            <Button Name="PART_FullScreenButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.Fullscreen}"
                                    Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                    WindowDecorationProperties.ElementRole="FullScreenButton">
                                <lucide:LucideIcon Kind="Maximize2" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                            </Button>

                            <!-- 最小化 -->
                            <Button Name="PART_MinimizeButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.Minimize}"
                                    Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                    WindowDecorationProperties.ElementRole="MinimizeButton">
                                <lucide:LucideIcon Kind="Minus" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                            </Button>

                            <!-- 最大化和窗口化 -->
                            <Button Name="PART_MaximizeButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.Maximize}"
                                    Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                    WindowDecorationProperties.ElementRole="MaximizeButton">
                                <Grid>
                                    <lucide:LucideIcon Name="PartMaximizeIcon" Kind="Square" Size="{DynamicResource Vhilz.CaptionButton.Icon.Maximize.Size}"
                                                       StrokeWidth="{DynamicResource Vhilz.CaptionButton.Icon.StrokeWidth}" />
                                    <vhz:CaptionGeometryIcon Name="PartRestoreIcon"
                                                             Data="{DynamicResource Vhilz.CaptionButton.Icon.Restore.Geometry}"
                                                             Size="{DynamicResource Vhilz.CaptionButton.Icon.Size}"
                                                             StrokeWidth="{DynamicResource Vhilz.CaptionButton.Icon.Restore.StrokeWidth}"
                                                             IsVisible="False" />
                                </Grid>
                            </Button>

                            <!-- 关闭按钮 -->
                            <Button Name="PART_CloseButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.Close}"
                                    Classes="VhilzCaptionClose"
                                    Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                    WindowDecorationProperties.ElementRole="CloseButton">
                                <lucide:LucideIcon Kind="X" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                            </Button>

                        </StackPanel>
                    </WindowDrawnDecorationsContent.Overlay>
                    <WindowDrawnDecorationsContent.FullscreenPopover>
                        <DockPanel vhz:DecorationRegistration.IsFullscreen="True"
                                   vhz:DecorationRegistration.Owner="{Binding $parent[vhz:VhilzWindow]}"
                                   Height="{TemplateBinding DefaultTitleBarHeight}"
                                   Margin="{DynamicResource Vhilz.Window.FullscreenTitleBar.Margin}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch"
                                   Background="{Binding $parent[vhz:VhilzWindow].TitleBarBackground}"
                                   WindowDecorationProperties.ElementRole="User">
                            <DockPanel.RenderTransform>
                                <TranslateTransform />
                            </DockPanel.RenderTransform>
                            <StackPanel vhz:DecorationRegistration.IsInactive="{Binding !$parent[vhz:VhilzWindow].IsActive, FallbackValue=False}"
                                        DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Name="PART_PopoverFullScreenButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.ExitFullscreen}"
                                        ToolTip.Tip="{DynamicResource Vhilz.Text.Window.ExitFullscreen}"
                                        Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                        WindowDecorationProperties.ElementRole="FullScreenButton">
                                    <lucide:LucideIcon Kind="Minimize2" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                </Button>
                                <Button Name="PART_PopoverCloseButton"
                                    AutomationProperties.Name="{DynamicResource Vhilz.Text.Window.Close}"
                                        Classes="VhilzCaptionClose"
                                        Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                        WindowDecorationProperties.ElementRole="CloseButton">
                                    <lucide:LucideIcon Kind="X" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                </Button>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Title}"
                                       Theme="{StaticResource Vhilz.Window.TitleBar.Title.Theme}"
                                       Classes.VhilzInactive="{Binding !$parent[vhz:VhilzWindow].IsActive, FallbackValue=False}" />
                        </DockPanel>
                    </WindowDrawnDecorationsContent.FullscreenPopover>
                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>
        <Style Selector="^ /template/ Button#PART_CloseButton, ^ /template/ Button#PART_PopoverCloseButton">
            <Setter Property="IsVisible" Value="{Binding $parent[vhz:VhilzWindow].IsCloseButtonVisible}" />
        </Style>
        <Style
            Selector="^ /template/ Button#PART_MinimizeButton, ^ /template/ Button#PART_MaximizeButton, ^ /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-minimize /template/ Button#PART_MinimizeButton">
            <Setter Property="IsVisible" Value="{Binding $parent[vhz:VhilzWindow].IsMinimizeButtonVisible}" />
        </Style>
        <Style Selector="^:has-maximize /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="{Binding $parent[vhz:VhilzWindow].IsRestoreButtonVisible}" />
        </Style>
        <Style
            Selector="^:has-fullscreen /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="{Binding $parent[vhz:VhilzWindow].IsFullScreenButtonVisible}" />
        </Style>
        <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Vhilz.Text.Window.Restore}" />
            <Style Selector="^ lucide|LucideIcon#PartMaximizeIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ vhz|CaptionGeometryIcon#PartRestoreIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style
            Selector="^:fullscreen /template/ Border#PartTitleBar, ^:fullscreen /template/ StackPanel#PART_CaptionButtons">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!-- 预览宿主不生成窗口装饰，直接复用按钮主题和图标资源；这里的容器仅用于设计时展示。 -->
    <Design.PreviewWith>
        <Border Width="640" Padding="20">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Themes/Resources/Tokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="/Themes/Resources/Dark.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                            <SolidColorBrush x:Key="Vhilz.Preview.WindowDecorations.BackgroundBrush">#18181B</SolidColorBrush>
                            <SolidColorBrush x:Key="Vhilz.Preview.WindowDecorations.ForegroundBrush">#FAFAFA</SolidColorBrush>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="/Themes/Resources/Light.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                            <SolidColorBrush x:Key="Vhilz.Preview.WindowDecorations.BackgroundBrush">#F4F4F5</SolidColorBrush>
                            <SolidColorBrush x:Key="Vhilz.Preview.WindowDecorations.ForegroundBrush">#18181B</SolidColorBrush>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <DataTemplate x:Key="Vhilz.Preview.WindowDecorations.Row.DataTemplate" x:DataType="x:String">
                        <Border Padding="12"
                                Background="{DynamicResource Vhilz.Preview.WindowDecorations.BackgroundBrush}"
                                TextElement.Foreground="{DynamicResource Vhilz.Preview.WindowDecorations.ForegroundBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding}" />
                                <StackPanel Height="{DynamicResource Vhilz.Window.TitleBar.Height}"
                                            Orientation="Horizontal">
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}">
                                        <lucide:LucideIcon Kind="Maximize" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}">
                                        <lucide:LucideIcon Kind="Minus" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}">
                                        <lucide:LucideIcon Kind="Square" Size="{DynamicResource Vhilz.CaptionButton.Icon.Maximize.Size}"
                                                           StrokeWidth="{DynamicResource Vhilz.CaptionButton.Icon.StrokeWidth}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}">
                                        <vhz:CaptionGeometryIcon
                                            Data="{DynamicResource Vhilz.CaptionButton.Icon.Restore.Geometry}"
                                            Size="{DynamicResource Vhilz.CaptionButton.Icon.Size}"
                                            StrokeWidth="{DynamicResource Vhilz.CaptionButton.Icon.Restore.StrokeWidth}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}">
                                        <lucide:LucideIcon Kind="Expand" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                            Classes="VhilzCaptionClose">
                                        <lucide:LucideIcon Kind="X" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                    </Button>
                                    <Button Theme="{StaticResource Vhilz.CaptionButton.Theme}"
                                            Classes="VhilzCaptionClose" IsEnabled="False">
                                        <lucide:LucideIcon Kind="X" Theme="{StaticResource Vhilz.CaptionButton.Icon.Theme}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ResourceDictionary>
            </Border.Resources>
            <StackPanel Spacing="12">
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <ContentPresenter
                        ContentTemplate="{StaticResource Vhilz.Preview.WindowDecorations.Row.DataTemplate}"
                        Content="暗色" />
                </ThemeVariantScope>
                <ThemeVariantScope RequestedThemeVariant="Light">
                    <ContentPresenter
                        ContentTemplate="{StaticResource Vhilz.Preview.WindowDecorations.Row.DataTemplate}"
                        Content="明色" />
                </ThemeVariantScope>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
</ResourceDictionary>
