<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.GridSplitter.Hit.Thickness">6</x:Double>
    <x:Double x:Key="Vhilz.GridSplitter.Line.Thickness">1</x:Double>
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinWidth" Value="{DynamicResource Vhilz.GridSplitter.Hit.Thickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.GridSplitter.Hit.Thickness}" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="PreviewContent">
            <Template>
                <Rectangle Fill="{DynamicResource Vhilz.Brush.Selection}" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Line"
                            Width="{DynamicResource Vhilz.GridSplitter.Line.Thickness}"
                            HorizontalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[ResizeDirection=Rows] /template/ Border#PART_Line, ^[HorizontalAlignment=Stretch][ResizeDirection=Auto] /template/ Border#PART_Line">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="{DynamicResource Vhilz.GridSplitter.Line.Thickness}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.TextSecondary}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Primary}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
