<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <GridLength x:Key="Vhilz.Slider.PreContentMargin">8</GridLength>
    <GridLength x:Key="Vhilz.Slider.PostContentMargin">8</GridLength>
    <x:Double x:Key="Vhilz.Slider.HorizontalThumbWidth">16</x:Double>
    <x:Double x:Key="Vhilz.Slider.HorizontalThumbHeight">16</x:Double>
    <x:Double x:Key="Vhilz.Slider.VerticalThumbWidth">16</x:Double>
    <x:Double x:Key="Vhilz.Slider.VerticalThumbHeight">16</x:Double>
    <Thickness x:Key="Vhilz.Slider.Border.Thickness">0</Thickness>
    <SolidColorBrush x:Key="Vhilz.Slider.Container.Background">Transparent</SolidColorBrush>
    <x:Double x:Key="Vhilz.Slider.Track.Thickness">4</x:Double>
    <x:Double x:Key="Vhilz.Slider.Tick.Size">4</x:Double>
    <ControlTheme x:Key="Vhilz.Slider.HorizontalTrack.Theme" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="FocusTarget" Margin="0,-10" Background="Transparent" />
                    <Border Name="TrackBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Vhilz.Radius.Full}"
                            Height="{DynamicResource Vhilz.Slider.Track.Thickness}"
                            VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.Slider.VerticalTrack.Theme" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="FocusTarget" Margin="0,-10" Background="Transparent" />
                    <Border Name="TrackBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Vhilz.Radius.Full}"
                            Width="{DynamicResource Vhilz.Slider.Track.Thickness}"
                            HorizontalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.Slider.Thumb.Theme" TargetType="Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Primary}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Border}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Vhilz.Radius.Full}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Slider.Border.Thickness}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Primary}" />
        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid x:Name="SliderContainer"
                                  Margin="{TemplateBinding Padding}"
                                  Background="{DynamicResource Vhilz.Slider.Container.Background}">
                                <Grid.Styles>
                                    <Style Selector="TickBar">
                                        <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                                    </Style>
                                </Grid.Styles>
                                <Grid x:Name="HorizontalTemplate"
                                      MinHeight="{DynamicResource Vhilz.Height.Control}"
                                      ColumnDefinitions="Auto,Auto,*">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{DynamicResource Vhilz.Slider.PreContentMargin}" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{DynamicResource Vhilz.Slider.PostContentMargin}" />
                                    </Grid.RowDefinitions>
                                    <TickBar Name="TopTickBar"
                                             Grid.ColumnSpan="3"
                                             Ticks="{TemplateBinding Ticks}"
                                             TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                             Orientation="{TemplateBinding Slider.Orientation}"
                                             Minimum="{TemplateBinding Slider.Minimum}"
                                             Maximum="{TemplateBinding Slider.Maximum}"
                                             Height="{DynamicResource Vhilz.Slider.Tick.Size}"
                                             Margin="0,0,0,4"
                                             VerticalAlignment="Bottom"
                                             Placement="Top"
                                             IsVisible="False"
                                             IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                             Fill="{DynamicResource Vhilz.Brush.TextMuted}" />
                                    <TickBar Name="BottomTickBar"
                                             Grid.Row="2"
                                             Grid.ColumnSpan="3"
                                             Ticks="{TemplateBinding Ticks}"
                                             TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                             Orientation="{TemplateBinding Slider.Orientation}"
                                             Minimum="{TemplateBinding Slider.Minimum}"
                                             Maximum="{TemplateBinding Slider.Maximum}"
                                             Height="{DynamicResource Vhilz.Slider.Tick.Size}"
                                             Margin="0,4,0,0"
                                             VerticalAlignment="Top"
                                             Placement="Bottom"
                                             IsVisible="False"
                                             IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                             Fill="{DynamicResource Vhilz.Brush.TextMuted}" />
                                    <Track Name="PART_Track"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value, Mode=TwoWay}"
                                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                           Orientation="Horizontal">
                                        <Track.DecreaseButton>
                                            <RepeatButton Name="PART_DecreaseButton"
                                                          Theme="{StaticResource Vhilz.Slider.HorizontalTrack.Theme}"
                                                          Background="{TemplateBinding Foreground}"
                                                          Focusable="False" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton Name="PART_IncreaseButton"
                                                          Theme="{StaticResource Vhilz.Slider.HorizontalTrack.Theme}"
                                                          Background="{TemplateBinding Background}"
                                                          Focusable="False" />
                                        </Track.IncreaseButton>
                                        <Thumb Name="thumb"
                                               Width="{DynamicResource Vhilz.Slider.HorizontalThumbWidth}"
                                               Height="{DynamicResource Vhilz.Slider.HorizontalThumbHeight}"
                                               Margin="0"
                                               Padding="0"
                                               Background="{DynamicResource Vhilz.Brush.Surface}"
                                               BorderThickness="{DynamicResource Vhilz.Thickness.Border}"
                                               Theme="{StaticResource Vhilz.Slider.Thumb.Theme}"
                                               DataContext="{TemplateBinding Value}" />
                                    </Track>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid x:Name="SliderContainer"
                                  Grid.Row="1"
                                  Background="{DynamicResource Vhilz.Slider.Container.Background}"
                                  Margin="{TemplateBinding Padding}">
                                <Grid.Styles>
                                    <Style Selector="TickBar">
                                        <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                                    </Style>
                                </Grid.Styles>
                                <Grid x:Name="VerticalTemplate"
                                      MinWidth="{DynamicResource Vhilz.Height.Control}"
                                      RowDefinitions="*,Auto,Auto">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{DynamicResource Vhilz.Slider.PreContentMargin}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Vhilz.Slider.PostContentMargin}" />
                                    </Grid.ColumnDefinitions>
                                    <TickBar Name="LeftTickBar"
                                             Grid.RowSpan="3"
                                             Ticks="{TemplateBinding Ticks}"
                                             TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                             Orientation="{TemplateBinding Slider.Orientation}"
                                             Minimum="{TemplateBinding Slider.Minimum}"
                                             Maximum="{TemplateBinding Slider.Maximum}"
                                             Width="{DynamicResource Vhilz.Slider.Tick.Size}"
                                             Margin="0,0,4,0"
                                             HorizontalAlignment="Right"
                                             Placement="Left"
                                             IsVisible="False"
                                             IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                             Fill="{DynamicResource Vhilz.Brush.TextMuted}" />
                                    <TickBar Name="RightTickBar"
                                             Grid.RowSpan="3"
                                             Grid.Column="2"
                                             Ticks="{TemplateBinding Ticks}"
                                             TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                             Orientation="{TemplateBinding Slider.Orientation}"
                                             Minimum="{TemplateBinding Slider.Minimum}"
                                             Maximum="{TemplateBinding Slider.Maximum}"
                                             Width="{DynamicResource Vhilz.Slider.Tick.Size}"
                                             Margin="4,0,0,0"
                                             HorizontalAlignment="Left"
                                             Placement="Right"
                                             IsVisible="False"
                                             IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                             Fill="{DynamicResource Vhilz.Brush.TextMuted}" />
                                    <Track Name="PART_Track"
                                           Grid.RowSpan="3"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="1"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value, Mode=TwoWay}"
                                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                           Orientation="Vertical">
                                        <Track.DecreaseButton>
                                            <RepeatButton Name="PART_DecreaseButton"
                                                          Theme="{StaticResource Vhilz.Slider.VerticalTrack.Theme}"
                                                          Background="{TemplateBinding Foreground}"
                                                          Focusable="False" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton Name="PART_IncreaseButton"
                                                          Background="{TemplateBinding Background}"
                                                          Theme="{StaticResource Vhilz.Slider.VerticalTrack.Theme}"
                                                          Focusable="False" />
                                        </Track.IncreaseButton>
                                        <Thumb Name="SliderThumb"
                                               Width="{DynamicResource Vhilz.Slider.VerticalThumbWidth}"
                                               Height="{DynamicResource Vhilz.Slider.VerticalThumbHeight}"
                                               Margin="0"
                                               Padding="0"
                                               Background="{DynamicResource Vhilz.Brush.Surface}"
                                               BorderThickness="{DynamicResource Vhilz.Thickness.Border}"
                                               Theme="{StaticResource Vhilz.Slider.Thumb.Theme}"
                                               DataContext="{TemplateBinding Value}" />
                                    </Track>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled) /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style Selector="^:error">
            <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Danger}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled) /template/ Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Focus}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
