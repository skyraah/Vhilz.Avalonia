<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="{DynamicResource Vhilz.Radius.Small}"
                        BorderBrush="{DynamicResource Vhilz.Brush.Focus}"
                        BorderThickness="{DynamicResource Vhilz.Thickness.Focus}" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
