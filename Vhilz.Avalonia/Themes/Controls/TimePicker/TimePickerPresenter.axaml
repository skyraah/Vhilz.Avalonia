<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <ControlTheme x:Key="Vhilz.TimePickerPresenter.Theme" TargetType="TimePickerPresenter">
        <Setter Property="Width" Value="{DynamicResource Vhilz.TimePicker.Width}" />
        <Setter Property="MinWidth" Value="{DynamicResource Vhilz.TimePicker.MinWidth}" />
        <Setter Property="MaxHeight" Value="{DynamicResource Vhilz.TimePicker.MaxHeight}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource Vhilz.DateTimePickerShared.DateTimeFlyoutBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Background"
                        MaxHeight="{DynamicResource Vhilz.TimePicker.Background.MaxHeight}"
                        Padding="{DynamicResource Vhilz.DateTimePickerShared.DateTimeFlyoutBorderPadding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Vhilz.Radius.Small}"
                        BoxShadow="{DynamicResource Vhilz.Shadow.Popup}">
                    <Grid Name="ContentPanel" RowDefinitions="*,Auto">
                        <Grid Name="PART_PickerContainer">
                            <Grid.Styles>
                                <Style Selector="DateTimePickerPanel &gt; ListBoxItem">
                                    <Setter Property="Theme" Value="{StaticResource Vhilz.DateTimePicker.Item.Theme}" />
                                </Style>
                            </Grid.Styles>
                            <Panel Name="PART_HourHost" Grid.Column="0">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden">
                                    <DateTimePickerPanel Name="PART_HourSelector"
                                                         ItemHeight="{DynamicResource Vhilz.TimePicker.FlyoutPresenterItemHeight}"
                                                         PanelType="Hour"
                                                         ShouldLoop="True" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_HourUpButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.UpButton.Theme}" />
                                <RepeatButton Name="PART_HourDownButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.DownButton.Theme}" />
                            </Panel>
                            <Panel Name="PART_MinuteHost" Grid.Column="2">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden">
                                    <DateTimePickerPanel Name="PART_MinuteSelector"
                                                         ItemHeight="{DynamicResource Vhilz.TimePicker.FlyoutPresenterItemHeight}"
                                                         PanelType="Minute"
                                                         ShouldLoop="True" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_MinuteUpButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.UpButton.Theme}" />
                                <RepeatButton Name="PART_MinuteDownButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.DownButton.Theme}" />
                            </Panel>
                            <Panel Name="PART_SecondHost" Grid.Column="4">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden">
                                    <DateTimePickerPanel Name="PART_SecondSelector"
                                                         ItemHeight="{DynamicResource Vhilz.TimePicker.FlyoutPresenterItemHeight}"
                                                         PanelType="Second"
                                                         ShouldLoop="True" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_SecondUpButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.UpButton.Theme}" />
                                <RepeatButton Name="PART_SecondDownButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.DownButton.Theme}" />
                            </Panel>
                            <Panel Name="PART_PeriodHost" Grid.Column="6">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden">
                                    <DateTimePickerPanel Name="PART_PeriodSelector"
                                                         ItemHeight="{DynamicResource Vhilz.TimePicker.FlyoutPresenterItemHeight}"
                                                         PanelType="TimePeriod"
                                                         ShouldLoop="False" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_PeriodUpButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.UpButton.Theme}" />
                                <RepeatButton Name="PART_PeriodDownButton"
                                              Theme="{StaticResource Vhilz.DateTimePicker.DownButton.Theme}" />
                            </Panel>
                            <Rectangle x:Name="HighlightRect"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="5"
                                       Height="{DynamicResource Vhilz.TimePicker.FlyoutPresenterHighlightHeight}"
                                       VerticalAlignment="Center"
                                       ZIndex="-1">
                                <Rectangle.Fill>
                                    <SolidColorBrush Opacity="{DynamicResource Vhilz.TimePicker.SolidColorBrush.Opacity}"
                                                     Color="{DynamicResource Vhilz.Color.Selection}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Name="PART_FirstSpacer"
                                       Grid.Column="1"
                                       Width="{DynamicResource Vhilz.TimePicker.SpacerThemeWidth}"
                                       HorizontalAlignment="Center"
                                       Fill="{DynamicResource Vhilz.Brush.Border}" />
                            <Rectangle Name="PART_SecondSpacer"
                                       Grid.Column="3"
                                       Width="{DynamicResource Vhilz.TimePicker.SpacerThemeWidth}"
                                       HorizontalAlignment="Center"
                                       Fill="{DynamicResource Vhilz.Brush.Border}" />
                            <Rectangle Name="PART_ThirdSpacer"
                                       Grid.Column="5"
                                       Width="{DynamicResource Vhilz.TimePicker.SpacerThemeWidth}"
                                       HorizontalAlignment="Center"
                                       Fill="{DynamicResource Vhilz.Brush.Border}" />
                        </Grid>
                        <Grid Name="AcceptDismissGrid" Grid.Row="1" ColumnDefinitions="*,*">
                            <Rectangle Grid.ColumnSpan="2"
                                       Height="{DynamicResource Vhilz.TimePicker.SpacerThemeWidth}"
                                       VerticalAlignment="Top"
                                       Fill="{DynamicResource Vhilz.Brush.Border}" />
                            <Button Name="PART_AcceptButton"
                                    Grid.Column="0"
                                    Height="{DynamicResource Vhilz.TimePicker.FlyoutPresenterAcceptDismissHostGridHeight}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Theme="{StaticResource Vhilz.DateTimePicker.Button.Theme}">
                                <Path Data="M0.5,8.5 5,13.5 15.5,3"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeLineCap="Round"
                                      StrokeThickness="{DynamicResource Vhilz.TimePicker.Path.StrokeThickness}" />
                            </Button>
                            <Button Name="PART_DismissButton"
                                    Grid.Column="1"
                                    Height="{DynamicResource Vhilz.TimePicker.FlyoutPresenterAcceptDismissHostGridHeight}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    FontSize="{DynamicResource Vhilz.TimePicker.DismissButton.FontSize}"
                                    Theme="{StaticResource Vhilz.DateTimePicker.Button.Theme}">
                                <Path Data="M2,2 14,14 M2,14 14 2"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeLineCap="Round"
                                      StrokeThickness="{DynamicResource Vhilz.TimePicker.Path.StrokeThickness}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Panel">
            <Style Selector="^:pointerover RepeatButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TimePickerPresenter}"
                  TargetType="TimePickerPresenter"
                  BasedOn="{StaticResource Vhilz.TimePickerPresenter.Theme}" />
</ResourceDictionary>
