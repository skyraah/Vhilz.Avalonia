<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vhz="https://github.com/skyraah/Vhilz.Avalonia">
    <ControlTheme x:Key="Vhilz.Button.Theme" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="vhz:ButtonMotion.ColorAnimationDuration" Value="{DynamicResource Vhilz.Duration.Fast}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Panel Background="Transparent">
                    <vhz:ButtonContentPresenter x:Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RenderTransformOrigin="50%,50%"
                                      RecognizesAccessKey="True"
                                      IsColorAnimationEnabled="{TemplateBinding vhz:ButtonMotion.IsColorAnimationEnabled}"
                                      ColorAnimationDuration="{TemplateBinding vhz:ButtonMotion.ColorAnimationDuration}"
                                      ColorEasing="{DynamicResource Vhilz.Easing.Standard}"
                                      TransformDuration="{DynamicResource Vhilz.Duration.Normal}"
                                      TransformEasing="{DynamicResource Vhilz.Easing.Spring}" />
                    <Border x:Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource Vhilz.Brush.Text}"
                            BorderThickness="{DynamicResource Vhilz.Thickness.Focus}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- 下沉表面超出原布局 1 DIP，保留完整边框；外层布局与命中区域不变。 -->
        <Style Selector="^[(vhz|ButtonMotion.PressAnimation)=Sink]">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="^[(vhz|ButtonMotion.PressAnimation)=Scale] /template/ vhz|ButtonContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^[(vhz|ButtonMotion.PressAnimation)=Sink] /template/ vhz|ButtonContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
            <Setter Property="TransformDuration" Value="{DynamicResource Vhilz.Duration.Fast}" />
            <Setter Property="TransformEasing" Value="{DynamicResource Vhilz.Easing.Decelerate}" />
        </Style>
        <Style Selector="^[IsDefault=True]">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.TextSecondary}" />
        </Style>
        <Style
            Selector="^:pointerover:not(:pressed):not(:disabled), ^:flyout-open:not(:pressed):not(:disabled), ^[(vhz|ButtonMotion.IsPressStyleEnabled)=False]:pointerover:not(:disabled), ^[(vhz|ButtonMotion.IsPressStyleEnabled)=False]:flyout-open:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlHover}" />
        </Style>
        <Style Selector="^[(vhz|ButtonMotion.IsPressStyleEnabled)=True]:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style
            Selector="^[(vhz|ButtonMotion.PressAnimation)=Scale]:pressed:not(:disabled) /template/ vhz|ButtonContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="{DynamicResource Vhilz.Transform.PressFeedback}" />
        </Style>
        <Style
            Selector="^[(vhz|ButtonMotion.PressAnimation)=Sink]:pressed:not(:disabled) /template/ vhz|ButtonContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="{DynamicResource Vhilz.Transform.PressSink}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled) /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
    <!-- 仅供原生模板内关闭/返回等辅助按钮消费，避免为普通 Button 新增 class 变体。 -->
    <ControlTheme x:Key="Vhilz.Button.Subtle.Theme" TargetType="Button" BasedOn="{StaticResource Vhilz.Button.Theme}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource Vhilz.Button.Theme}" />
    <Design.PreviewWith>
        <Border Width="640" Padding="20">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Themes/Resources/Tokens.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <DataTemplate x:Key="Vhilz.Preview.Button.Row.DataTemplate" x:DataType="x:String">
                        <Border Padding="16"
                                Background="{DynamicResource Vhilz.Brush.Surface}"
                                TextElement.Foreground="{DynamicResource Vhilz.Brush.Text}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Theme="{StaticResource Vhilz.Button.Theme}" Content="按钮"
                                            vhz:ButtonMotion.PressAnimation="Sink" />
                                    <Button Theme="{StaticResource Vhilz.Button.Theme}"
                                            vhz:ButtonMotion.PressAnimation="Scale" Content="较长的按钮文本" />
                                    <Button Theme="{StaticResource Vhilz.Button.Theme}"
                                            vhz:ButtonMotion.PressAnimation="Scale" Content="禁用" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ResourceDictionary>
            </Border.Resources>
            <StackPanel Spacing="12">
                <!-- 每行独立持有配色资源，使画笔内部的动态颜色引用跟随该行主题。 -->
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <ThemeVariantScope.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="/Themes/Resources/Dark.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </ThemeVariantScope.Resources>
                    <ContentPresenter Content="暗色"
                                      ContentTemplate="{StaticResource Vhilz.Preview.Button.Row.DataTemplate}" />
                </ThemeVariantScope>
                <ThemeVariantScope RequestedThemeVariant="Light">
                    <ThemeVariantScope.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="/Themes/Resources/Light.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </ThemeVariantScope.Resources>
                    <ContentPresenter Content="明色"
                                      ContentTemplate="{StaticResource Vhilz.Preview.Button.Row.DataTemplate}" />
                </ThemeVariantScope>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
</ResourceDictionary>
