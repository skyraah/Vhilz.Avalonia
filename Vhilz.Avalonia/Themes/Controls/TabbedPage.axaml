<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="Vhilz.Margin.TabbedPage0">0</Thickness>
    <ControlTheme x:Key="Vhilz.TabControl.TabbedPage.Theme" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_TabStrip"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="{DynamicResource Vhilz.Margin.TabbedPage0}"
                            Padding="{TemplateBinding Padding}"
                            DockPanel.Dock="{TemplateBinding TabStripPlacement}">
                        <ItemsPresenter Name="PART_ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                    </Border>
                    <Panel ClipToBounds="True">
                        <ContentPresenter Name="PART_SelectedContentHost2"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="False" />
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter &gt; UniformGrid, ^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter &gt; UniformGrid">
            <Setter Property="Rows" Value="0" />
            <Setter Property="Columns" Value="1" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.TabbedPage.Theme" TargetType="TabbedPage">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Surface}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <TabControl Name="PART_TabControl"
                                Theme="{StaticResource Vhilz.TabControl.TabbedPage.Theme}"
                                ItemContainerTheme="{StaticResource Vhilz.TabItem.Theme}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage" BasedOn="{StaticResource Vhilz.TabbedPage.Theme}" />
</ResourceDictionary>
