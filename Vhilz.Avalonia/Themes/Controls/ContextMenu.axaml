<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="Vhilz.ContextMenu.Theme" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="TextBlock.FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="TextBlock.FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Popup}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Border}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource Vhilz.Shadow.Popup}">
                    <ScrollViewer Theme="{StaticResource Vhilz.ScrollViewer.Menu.Theme}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        KeyboardNavigation.TabNavigation="Continue" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ContextMenu}"
                  TargetType="ContextMenu"
                  BasedOn="{StaticResource Vhilz.ContextMenu.Theme}" />
</ResourceDictionary>
