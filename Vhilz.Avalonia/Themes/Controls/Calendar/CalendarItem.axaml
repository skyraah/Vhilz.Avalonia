<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="Vhilz.CalendarItem.Border.Margin">0,2,0,2</Thickness>
    <Thickness x:Key="Vhilz.CalendarItem.Border.BorderThickness">2</Thickness>
    <CornerRadius x:Key="Vhilz.CalendarItem.Border.CornerRadius">1</CornerRadius>
    <x:Double x:Key="Vhilz.CalendarItem.Rectangle.Height">22</x:Double>
    <x:Double x:Key="Vhilz.CalendarItem.Path.Width">6</x:Double>
    <x:Double x:Key="Vhilz.CalendarItem.Path.Height">10</x:Double>
    <Thickness x:Key="Vhilz.CalendarItem.MonthView.Margin">6,-1,6,6</Thickness>
    <Thickness x:Key="Vhilz.CalendarItem.YearView.Margin">6,-3,7,6</Thickness>
    <Thickness x:Key="Vhilz.CalendarItem.DisabledVisual.Margin">0,2,0,2</Thickness>
    <Thickness x:Key="Vhilz.CalendarItem.TextBlock.Margin">0,4,0,4</Thickness>
    <ControlTheme x:Key="Vhilz.CalendarItem.Theme" TargetType="CalendarItem">
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Margin="{DynamicResource Vhilz.CalendarItem.Border.Margin}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border BorderBrush="{DynamicResource Vhilz.Brush.Popup}"
                                BorderThickness="{DynamicResource Vhilz.CalendarItem.Border.BorderThickness}"
                                CornerRadius="{DynamicResource Vhilz.CalendarItem.Border.CornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="3"
                                           Height="{DynamicResource Vhilz.CalendarItem.Rectangle.Height}"
                                           VerticalAlignment="Top"
                                           Fill="{TemplateBinding HeaderBackground}"
                                           Stretch="Fill" />
                                <Button Name="PART_PreviousButton"
                                        HorizontalAlignment="Left"
                                        IsVisible="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{DynamicResource Vhilz.FontSize.Body}"
                                        FontWeight="Medium"
                                        Padding="{DynamicResource Vhilz.Padding.Item}"
                                        MinHeight="{DynamicResource Vhilz.Height.Control}">
                                    <Path Width="{DynamicResource Vhilz.CalendarItem.Path.Width}"
                                          Height="{DynamicResource Vhilz.CalendarItem.Path.Height}"
                                          Margin="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Data="M288.75,232.25 L288.75,240.625 L283,236.625 z"
                                          Stretch="Fill"
                                          Fill="{DynamicResource Vhilz.Brush.Text}" />
                                </Button>
                                <Button Name="PART_HeaderButton"
                                        Grid.Column="1"
                                        Padding="{DynamicResource Vhilz.Padding.Item}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Vhilz.FontSize.Body}"
                                        FontWeight="Medium"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        MinHeight="{DynamicResource Vhilz.Height.Control}" />
                                <Button Name="PART_NextButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        IsVisible="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{DynamicResource Vhilz.FontSize.Body}"
                                        FontWeight="Medium"
                                        Padding="{DynamicResource Vhilz.Padding.Item}"
                                        MinHeight="{DynamicResource Vhilz.Height.Control}">
                                    <Path Width="{DynamicResource Vhilz.CalendarItem.Path.Width}"
                                          Height="{DynamicResource Vhilz.CalendarItem.Path.Height}"
                                          Margin="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M282.875,231.875 L282.875,240.375 L288.625,236 z"
                                          Stretch="Fill"
                                          Fill="{DynamicResource Vhilz.Brush.Text}" />
                                </Button>
                                <Grid Name="PART_MonthView"
                                      Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      Margin="{DynamicResource Vhilz.CalendarItem.MonthView.Margin}"
                                      IsVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <Grid Name="PART_YearView"
                                      Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      Margin="{DynamicResource Vhilz.CalendarItem.YearView.Margin}"
                                      IsVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                    <Rectangle Name="DisabledVisual"
                               Margin="{DynamicResource Vhilz.CalendarItem.DisabledVisual.Margin}"
                               Fill="{DynamicResource Vhilz.Brush.Control}"
                               IsVisible="False"
                               Opacity="{DynamicResource Vhilz.Opacity.Disabled}"
                               Stretch="Fill" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="DayTitleTemplate">
            <Template x:DataType="x:String">
                <TextBlock Margin="{DynamicResource Vhilz.CalendarItem.TextBlock.Margin}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Vhilz.FontSize.Caption}"
                           FontWeight="Normal"
                           Text="{Binding}"
                           Foreground="{DynamicResource Vhilz.Brush.TextMuted}" />
            </Template>
        </Setter>
        <Style Selector="^:calendardisabled /template/ Rectangle#DisabledVisual">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type CalendarItem}"
                  TargetType="CalendarItem"
                  BasedOn="{StaticResource Vhilz.CalendarItem.Theme}" />
</ResourceDictionary>
