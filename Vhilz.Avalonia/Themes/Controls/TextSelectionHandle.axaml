<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.Size.TextSelectionHandle">24</x:Double>
    <DrawingImage x:Key="Vhilz.Drawing.TextSelectionHandle">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="{DynamicResource Vhilz.Geometry.TextSelectionHandle}"
                             Brush="{DynamicResource Vhilz.Brush.Primary}">
                <GeometryDrawing.Pen>
                    <Pen Thickness="0.5" Brush="{DynamicResource Vhilz.Brush.Text}" LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Vhilz.Drawing.TextCaretHandle">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="{DynamicResource Vhilz.Geometry.TextCaretHandle}"
                             Brush="{DynamicResource Vhilz.Brush.Primary}">
                <GeometryDrawing.Pen>
                    <Pen Thickness="0.5" Brush="{DynamicResource Vhilz.Brush.Text}" LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>
    <GeometryGroup x:Key="Vhilz.Geometry.TextSelectionHandle">
        <CombinedGeometry>
            <CombinedGeometry.Geometry1>
                <RectangleGeometry Rect="0,0,16,16" />
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
    </GeometryGroup>
    <GeometryGroup x:Key="Vhilz.Geometry.TextCaretHandle">
        <CombinedGeometry>
            <CombinedGeometry.Geometry1>
                <RectangleGeometry Rect="0,0,16,16">
                    <RectangleGeometry.Transform>
                        <TransformGroup>
                            <RotateTransform CenterX="16" Angle="-45" />
                        </TransformGroup>
                    </RectangleGeometry.Transform>
                </RectangleGeometry>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="16,22.7" RadiusX="16" RadiusY="16" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
    </GeometryGroup>
    <ControlTheme x:Key="{x:Type TextSelectionHandle}" TargetType="TextSelectionHandle">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border Padding="0,0,0,10" IsHitTestVisible="True" Background="Transparent">
                            <Image Stretch="Uniform"
                                   Cursor="Arrow"
                                   Name="PART_HandlePathIcon"
                                   Height="{DynamicResource Vhilz.Size.TextSelectionHandle}"
                                   Source="{DynamicResource Vhilz.Drawing.TextSelectionHandle}" />
                        </Border>
                        <Border Background="Transparent"
                                Name="PART_Indicator"
                                HorizontalAlignment="Center"
                                Width="1"
                                VerticalAlignment="Top"
                                Height="5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:caret /template/ Image#PART_HandlePathIcon">
            <Setter Property="Source" Value="{DynamicResource Vhilz.Drawing.TextCaretHandle}" />
        </Style>
        <Style Selector="^:start /template/ Image#PART_HandlePathIcon">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="-1" ScaleY="1" />
            </Setter>
        </Style>
        <Style Selector="^:caret /template/ Border#PART_Indicator">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:end /template/ Border#PART_Indicator">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^:start /template/ Border#PART_Indicator">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
