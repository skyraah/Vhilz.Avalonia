<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.ComboBox.PlaceholderTextBlock.Opacity">1</x:Double>
    <x:Double x:Key="Vhilz.ComboBox.EditableTextBox.Opacity">1</x:Double>
    <x:Double x:Key="Vhilz.ComboBox.Path.Width">8</x:Double>
    <x:Double x:Key="Vhilz.ComboBox.Path.Height">4</x:Double>
    <Thickness x:Key="Vhilz.ComboBox.FocusVisual.Margin">-2</Thickness>
    <ControlTheme x:Key="Vhilz.ComboBox.Toggle.Theme" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.ComboBox.Theme" TargetType="ComboBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Border}" />
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Control}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Vhilz.Brush.TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <DataValidationErrors>
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Name="PlaceholderTextBlock"
                                           Grid.Column="0"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Opacity="{DynamicResource Vhilz.ComboBox.PlaceholderTextBlock.Opacity}"
                                           Text="{TemplateBinding PlaceholderText}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="SelectionBoxItem"
                                                     RelativeSource="{RelativeSource TemplatedParent}"
                                                     Converter="{x:Static ObjectConverters.IsNull}" />
                                            <Binding Path="!IsEditable"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <ContentControl Margin="{TemplateBinding Padding}"
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
                                <TextBox Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Padding="{TemplateBinding Padding}"
                                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         Text="{TemplateBinding Text, Mode=TwoWay}"
                                         PlaceholderText="{TemplateBinding PlaceholderText}"
                                         BorderThickness="0"
                                         IsVisible="{TemplateBinding IsEditable}"
                                         Opacity="{DynamicResource Vhilz.ComboBox.EditableTextBox.Opacity}" />
                                <ToggleButton Name="toggle"
                                              Grid.Column="1"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Focusable="False"
                                              IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                              Theme="{StaticResource Vhilz.ComboBox.Toggle.Theme}">
                                    <Path Width="{DynamicResource Vhilz.ComboBox.Path.Width}"
                                          Height="{DynamicResource Vhilz.ComboBox.Path.Height}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z"
                                          Fill="{DynamicResource Vhilz.Brush.Text}"
                                          Stretch="Uniform" />
                                </ToggleButton>
                                <Popup Name="PART_Popup"
                                       MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                       MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                       IsLightDismissEnabled="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                       PlacementTarget="{TemplateBinding}"
                                       InheritsTransform="True">
                                    <Border Background="{DynamicResource Vhilz.Brush.Popup}"
                                            BorderBrush="{DynamicResource Vhilz.Brush.Border}"
                                            BorderThickness="{DynamicResource Vhilz.Thickness.Border}"
                                            CornerRadius="{DynamicResource Vhilz.Radius.Small}"
                                            Padding="{DynamicResource Vhilz.Padding.Popup}"
                                            BoxShadow="{DynamicResource Vhilz.Shadow.Popup}">
                                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                      IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                                      ScrollViewer.IsScrollChainingEnabled="False">
                                            <ItemsPresenter Name="PART_ItemsPresenter"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                    <Border Name="FocusVisual"
                            BorderBrush="{DynamicResource Vhilz.Brush.Focus}"
                            BorderThickness="{DynamicResource Vhilz.Thickness.Focus}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{DynamicResource Vhilz.ComboBox.FocusVisual.Margin}"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsEditable=true]">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        </Style>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlHover}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style Selector="^:error">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Danger}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-within:not(:disabled) /template/ Border#FocusVisual">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox" BasedOn="{StaticResource Vhilz.ComboBox.Theme}" />
</ResourceDictionary>
