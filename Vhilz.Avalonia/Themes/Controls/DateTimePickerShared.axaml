<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.DateTimePickerShared.Height">22</x:Double>
    <x:Double x:Key="Vhilz.DateTimePickerShared.Viewbox.Width">10</x:Double>
    <x:Double x:Key="Vhilz.DateTimePickerShared.Viewbox.Height">10</x:Double>
    <x:Double x:Key="Vhilz.DateTimePickerShared.Path.StrokeThickness">1</x:Double>
    <Thickness x:Key="Vhilz.DateTimePickerShared.DateTimeFlyoutButtonBorderThickness">0</Thickness>
    <Thickness x:Key="Vhilz.DateTimePickerShared.DateTimeFlyoutBorderThickness">1</Thickness>
    <Thickness x:Key="Vhilz.DateTimePickerShared.DateTimeFlyoutBorderPadding">1</Thickness>
    <ControlTheme x:Key="Vhilz.DateTimePicker.Item.Theme"
                  BasedOn="{StaticResource {x:Type ListBoxItem}}"
                  TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Focus}" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Item}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Style Selector="^.MonthItem">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource Vhilz.DatePicker.FlyoutPresenterMonthPadding}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.DateTimePicker.Button.Theme" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="Height" Value="{DynamicResource Vhilz.DateTimePickerShared.Height}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Focus}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlHover}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled)">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.DateTimePicker.UpButton.Theme"
                  BasedOn="{StaticResource Vhilz.DateTimePicker.Button.Theme}"
                  TargetType="RepeatButton">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="{DynamicResource Vhilz.DateTimePickerShared.Height}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Content">
            <Template>
                <Viewbox Width="{DynamicResource Vhilz.DateTimePickerShared.Viewbox.Width}"
                         Height="{DynamicResource Vhilz.DateTimePickerShared.Viewbox.Height}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Data="M 0,9 L 9,0 L 18,9"
                          Stroke="{Binding $parent[RepeatButton].Foreground}"
                          StrokeThickness="{DynamicResource Vhilz.DateTimePickerShared.Path.StrokeThickness}" />
                </Viewbox>
            </Template>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.DateTimePicker.DownButton.Theme"
                  BasedOn="{StaticResource Vhilz.DateTimePicker.Button.Theme}"
                  TargetType="RepeatButton">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Height" Value="{DynamicResource Vhilz.DateTimePickerShared.Height}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Content">
            <Template>
                <Viewbox Width="{DynamicResource Vhilz.DateTimePickerShared.Viewbox.Width}"
                         Height="{DynamicResource Vhilz.DateTimePickerShared.Viewbox.Height}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Data="M 0,0 L 9,9 L 18,0"
                          Stroke="{Binding $parent[RepeatButton].Foreground}"
                          StrokeThickness="{DynamicResource Vhilz.DateTimePickerShared.Path.StrokeThickness}" />
                </Viewbox>
            </Template>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
    </ControlTheme>
</ResourceDictionary>
