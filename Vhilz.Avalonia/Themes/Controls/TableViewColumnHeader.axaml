<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.Width.TableViewColumnHeader1">1</x:Double>
    <x:Double x:Key="Vhilz.Width.TableViewColumnResizer">4</x:Double>
    <Thickness x:Key="Vhilz.Margin.TableViewColumnResizer">0,-2,-1,-2</Thickness>
    <ControlTemplate x:Key="Vhilz.Template.TableViewColumnResizer" TargetType="Thumb">
        <Border Background="Transparent">
            <Rectangle Width="{DynamicResource Vhilz.Width.TableViewColumnHeader1}"
                       Fill="{DynamicResource Vhilz.Brush.Border}"
                       HorizontalAlignment="Center" />
        </Border>
    </ControlTemplate>
    <ControlTheme x:Key="Vhilz.TableViewColumnHeader.Theme" TargetType="TableViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.TextSecondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.TableViewCell}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    <Thumb Name="PART_Resizer"
                           Template="{StaticResource Vhilz.Template.TableViewColumnResizer}"
                           Width="{DynamicResource Vhilz.Width.TableViewColumnResizer}"
                           HorizontalAlignment="Right"
                           Cursor="SizeWestEast"
                           Margin="{DynamicResource Vhilz.Margin.TableViewColumnResizer}"
                           IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TableViewColumnHeader}"
                  TargetType="TableViewColumnHeader"
                  BasedOn="{StaticResource Vhilz.TableViewColumnHeader.Theme}" />
</ResourceDictionary>
