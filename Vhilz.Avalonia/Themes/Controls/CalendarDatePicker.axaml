<!-- 基于 Avalonia 12.1.3 官方模板保留原生部件与绑定；外观使用 Vhilz 语义资源。-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <x:Double x:Key="Vhilz.CalendarDatePicker.Path.Width">16</x:Double>
    <x:Double x:Key="Vhilz.CalendarDatePicker.Path.Height">16</x:Double>
    <x:Double x:Key="Vhilz.CalendarDatePicker.Path.StrokeThickness">1.3</x:Double>
    <x:Double x:Key="Vhilz.CalendarDatePicker.TextBox.Opacity">1</x:Double>
    <Thickness x:Key="Vhilz.CalendarDatePicker.FocusVisual.Margin">-2</Thickness>
    <ControlTheme x:Key="Vhilz.CalendarDatePicker.Button.Theme" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Focus}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Path Width="{DynamicResource Vhilz.CalendarDatePicker.Path.Width}"
                          Height="{DynamicResource Vhilz.CalendarDatePicker.Path.Height}"
                          Data="M 3,2 L 13,2 L 13,14 L 3,14 Z M 3,6 L 13,6 M 6,0 L 6,4 M 10,0 L 10,4"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="{DynamicResource Vhilz.CalendarDatePicker.Path.StrokeThickness}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlHover}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled)">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.CalendarDatePicker.Theme" TargetType="CalendarDatePicker">
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Vhilz.Brush.TextMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.Border}" />
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="PART_TextBox"
                                     Grid.Column="0"
                                     Padding="{TemplateBinding Padding}"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     Background="Transparent"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="0"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                                     UseFloatingPlaceholder="{TemplateBinding UseFloatingPlaceholder}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}"
                                     PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                     Opacity="{DynamicResource Vhilz.CalendarDatePicker.TextBox.Opacity}" />
                            <Button Name="PART_Button"
                                    Grid.Column="1"
                                    Width="{DynamicResource Vhilz.Height.Control}"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ClipToBounds="False"
                                    Focusable="False"
                                    Foreground="{TemplateBinding Foreground}"
                                    Theme="{StaticResource Vhilz.CalendarDatePicker.Button.Theme}" />
                            <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource Vhilz.Brush.Popup}"
                                        BorderBrush="{DynamicResource Vhilz.Brush.Border}"
                                        BorderThickness="{DynamicResource Vhilz.Thickness.Border}"
                                        CornerRadius="{DynamicResource Vhilz.Radius.Small}"
                                        Padding="{DynamicResource Vhilz.Padding.Popup}"
                                        BoxShadow="{DynamicResource Vhilz.Shadow.Popup}">
                                    <Calendar Name="PART_Calendar"
                                              DisplayDate="{TemplateBinding DisplayDate}"
                                              DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                              DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                              FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                              IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                              SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <Border Name="FocusVisual"
                            BorderBrush="{DynamicResource Vhilz.Brush.Focus}"
                            BorderThickness="{DynamicResource Vhilz.Thickness.Focus}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{DynamicResource Vhilz.CalendarDatePicker.FocusVisual.Margin}"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:error">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Danger}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-within:not(:disabled) /template/ Border#FocusVisual">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type CalendarDatePicker}"
                  TargetType="CalendarDatePicker"
                  BasedOn="{StaticResource Vhilz.CalendarDatePicker.Theme}" />
</ResourceDictionary>
