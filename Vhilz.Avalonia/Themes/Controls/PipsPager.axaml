<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Vhilz.Width.PipsPagerPip">8</x:Double>
    <x:Double x:Key="Vhilz.Width.PipsPagerHitTarget">24</x:Double>
    <x:Double x:Key="Vhilz.Width.PipsPagerNavigationGlyph">12</x:Double>
    <x:Double x:Key="Vhilz.Height.PipsPagerPip">8</x:Double>
    <x:Double x:Key="Vhilz.Height.PipsPagerHitTarget">24</x:Double>
    <x:Double x:Key="Vhilz.Height.PipsPagerNavigationGlyph">12</x:Double>
    <Thickness x:Key="Vhilz.Margin.PipsPagerNavigation">4</Thickness>
    <x:Double x:Key="Vhilz.Spacing.PipsPagerPips">4</x:Double>
    <ControlTheme x:Key="Vhilz.ListBoxItem.Pip.Theme" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource Vhilz.Width.PipsPagerHitTarget}" />
        <Setter Property="Height" Value="{DynamicResource Vhilz.Height.PipsPagerHitTarget}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_FocusBorder"
                        Background="Transparent"
                        CornerRadius="{DynamicResource Vhilz.Radius.Full}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{DynamicResource Vhilz.Thickness.Focus}">
                    <Ellipse Width="{DynamicResource Vhilz.Width.PipsPagerPip}"
                             Height="{DynamicResource Vhilz.Height.PipsPagerPip}"
                             Fill="{TemplateBinding Background}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Primary}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected):not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.TextMuted}" />
        </Style>
        <Style Selector="^:selected:pointerover:not(:pressed):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.PrimaryHover}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.PrimaryPressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled)">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.PipsPager.Theme" TargetType="PipsPager">
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="PreviousButtonTheme" Value="{StaticResource {x:Type Button}}" />
        <Setter Property="NextButtonTheme" Value="{StaticResource {x:Type Button}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Name="PART_RootPanel"
                            Orientation="{TemplateBinding Orientation}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="False">
                    <Button Name="PART_PreviousButton"
                            MinHeight="0"
                            Theme="{TemplateBinding PreviousButtonTheme}"
                            CornerRadius="{DynamicResource Vhilz.Radius.Full}"
                            Width="{DynamicResource Vhilz.Width.PipsPagerHitTarget}"
                            Height="{DynamicResource Vhilz.Height.PipsPagerHitTarget}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsVisible="{TemplateBinding IsPreviousButtonVisible}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="{DynamicResource Vhilz.Margin.PipsPagerNavigation}">
                        <PathIcon Width="{DynamicResource Vhilz.Width.PipsPagerNavigationGlyph}"
                                  Height="{DynamicResource Vhilz.Height.PipsPagerNavigationGlyph}"
                                  Data="M 8.12,2.29 L 3.41,7.00 C 3.14,7.27 3.14,7.71 3.41,7.98 L 8.12,12.69 C 8.57,13.14 9.33,12.82 9.33,12.19 L 9.33,2.79 C 9.33,2.16 8.57,1.84 8.12,2.29 Z" />
                    </Button>
                    <ListBox Name="PART_PipsPagerList"
                             ItemContainerTheme="{StaticResource Vhilz.ListBoxItem.Pip.Theme}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemsSource="{Binding TemplateSettings.Pips, RelativeSource={RelativeSource TemplatedParent}}"
                             SelectedIndex="{Binding SelectedPageIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             AutoScrollToSelectedItem="False"
                             ClipToBounds="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=PipsPager}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{DynamicResource Vhilz.Spacing.PipsPagerPips}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button Name="PART_NextButton"
                            MinHeight="0"
                            Theme="{TemplateBinding NextButtonTheme}"
                            CornerRadius="{DynamicResource Vhilz.Radius.Full}"
                            Width="{DynamicResource Vhilz.Width.PipsPagerHitTarget}"
                            Height="{DynamicResource Vhilz.Height.PipsPagerHitTarget}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsVisible="{TemplateBinding IsNextButtonVisible}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="{DynamicResource Vhilz.Margin.PipsPagerNavigation}">
                        <PathIcon Width="{DynamicResource Vhilz.Width.PipsPagerNavigationGlyph}"
                                  Height="{DynamicResource Vhilz.Height.PipsPagerNavigationGlyph}"
                                  Data="M 3.88,2.29 L 8.59,7.00 C 8.86,7.27 8.86,7.71 8.59,7.98 L 3.88,12.69 C 3.43,13.14 2.67,12.82 2.67,12.19 L 2.67,2.79 C 2.67,2.16 3.43,1.84 3.88,2.29 Z" />
                    </Button>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:vertical /template/ Button#PART_PreviousButton PathIcon">
            <Setter Property="Data"
                    Value="M 2.29,9.33 L 7.00,4.62 C 7.27,4.35 7.71,4.35 7.98,4.62 L 12.69,9.33 C 13.14,9.78 12.82,10.54 12.19,10.54 L 2.79,10.54 C 2.16,10.54 1.84,9.78 2.29,9.33 Z" />
        </Style>
        <Style Selector="^:vertical /template/ Button#PART_NextButton PathIcon">
            <Setter Property="Data"
                    Value="M 2.29,4.46 L 7.00,9.17 C 7.27,9.44 7.71,9.44 7.98,9.17 L 12.69,4.46 C 13.14,4.01 12.82,3.25 12.19,3.25 L 2.79,3.25 C 2.16,3.25 1.84,4.01 2.29,4.46 Z" />
        </Style>
        <Style Selector="^:first-page /template/ Button#PART_PreviousButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:last-page /template/ Button#PART_NextButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type PipsPager}" TargetType="PipsPager" BasedOn="{StaticResource Vhilz.PipsPager.Theme}" />
</ResourceDictionary>
