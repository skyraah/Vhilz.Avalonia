<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Controls.Converters">
    <x:Double x:Key="Vhilz.Width.SplitButtonGlyph">12</x:Double>
    <x:Double x:Key="Vhilz.Height.SplitButtonGlyph">12</x:Double>
    <x:Double x:Key="Vhilz.Width.SplitButtonPrimary">24</x:Double>
    <x:Double x:Key="Vhilz.Width.SplitButtonSecondary">24</x:Double>
    <x:Double x:Key="Vhilz.Width.SplitButtonSeparator">1</x:Double>
    <x:Double x:Key="Vhilz.Height.SplitButton">24</x:Double>
    <Thickness x:Key="Vhilz.Thickness.SplitButtonBorder">1</Thickness>
    <converters:MarginMultiplierConverter x:Key="Vhilz.Converter.SplitPrimaryBorder"
                                          Left="True"
                                          Top="True"
                                          Bottom="True"
                                          Indent="1" />
    <converters:MarginMultiplierConverter x:Key="Vhilz.Converter.SplitSecondaryBorder"
                                          Right="True"
                                          Top="True"
                                          Bottom="True"
                                          Indent="1" />
    <converters:MarginMultiplierConverter x:Key="Vhilz.Converter.SplitSeparatorBorder"
                                          Top="True"
                                          Bottom="True"
                                          Indent="1" />
    <converters:CornerRadiusFilterConverter x:Key="Vhilz.Converter.SplitRightRadius" Filter="TopRight, BottomRight" />
    <converters:CornerRadiusFilterConverter x:Key="Vhilz.Converter.SplitLeftRadius" Filter="TopLeft, BottomLeft" />
    <ControlTheme x:Key="Vhilz.Button.SplitComponent.Theme" TargetType="Button">
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RecognizesAccessKey" Value="True" />
        </Style>
        <Style Selector="^[Tag=checked] /template/ ContentPresenter#PART_ContentPresenter, ^[Tag=checked-flyout-open] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Selection}" />
            <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.OnSelection}" />
        </Style>
        <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlHover}" />
        </Style>
        <Style Selector="^:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ^[Tag=flyout-open]:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.ControlPressed}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="{DynamicResource Vhilz.Opacity.Disabled}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Vhilz.SplitButton.Theme" TargetType="SplitButton">
        <Setter Property="MinHeight" Value="{DynamicResource Vhilz.Height.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Vhilz.Radius.Small}" />
        <Setter Property="FontSize" Value="{DynamicResource Vhilz.FontSize.Body}" />
        <Setter Property="Background" Value="{DynamicResource Vhilz.Brush.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Vhilz.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Vhilz.Thickness.SplitButtonBorder}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource Vhilz.Padding.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PART_PrimaryButton"
                            Grid.Column="0"
                            Theme="{StaticResource Vhilz.Button.SplitComponent.Theme}"
                            MinWidth="{DynamicResource Vhilz.Width.SplitButtonPrimary}"
                            Foreground="{TemplateBinding Foreground}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource Vhilz.Converter.SplitPrimaryBorder}}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource Vhilz.Converter.SplitLeftRadius}}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False" />
                    <Border x:Name="SeparatorBorder"
                            Grid.Column="1"
                            Background="Transparent"
                            Width="{DynamicResource Vhilz.Width.SplitButtonSeparator}"
                            BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource Vhilz.Converter.SplitSeparatorBorder}}"
                            BorderBrush="{TemplateBinding BorderBrush}" />
                    <Button x:Name="PART_SecondaryButton"
                            Grid.Column="2"
                            Theme="{StaticResource Vhilz.Button.SplitComponent.Theme}"
                            MinWidth="{DynamicResource Vhilz.Width.SplitButtonSecondary}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Foreground="{TemplateBinding Foreground}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource Vhilz.Converter.SplitSecondaryBorder}}"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource Vhilz.Converter.SplitRightRadius}}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False">
                        <PathIcon Height="{DynamicResource Vhilz.Height.SplitButtonGlyph}"
                                  Width="{DynamicResource Vhilz.Width.SplitButtonGlyph}"
                                  Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:flyout-open /template/ Button">
            <Setter Property="Tag" Value="flyout-open" />
        </Style>
        <Style Selector="^:checked /template/ Button">
            <Setter Property="Tag" Value="checked" />
        </Style>
        <Style Selector="^:checked:flyout-open /template/ Button">
            <Setter Property="Tag" Value="checked-flyout-open" />
        </Style>
        <Style Selector="^:focus-visible:not(:disabled)">
            <Setter Property="BorderBrush" Value="{DynamicResource Vhilz.Brush.Focus}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type SplitButton}"
                  TargetType="SplitButton"
                  BasedOn="{StaticResource Vhilz.SplitButton.Theme}" />
</ResourceDictionary>
